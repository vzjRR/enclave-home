# ---------------------------------------------------------------
# Enclave RP — enclaverp.cc
#
# Copy to .env and fill in. Nothing here has a usable default in
# production: every value below is either required or degrades one
# section of the homepage to its "not configured" state.
# ---------------------------------------------------------------

# Port this service listens on. The store already uses 3000.
PORT=3001

# Interface to bind. Loopback by default, because Caddy proxies to
# 127.0.0.1 and a process on the public interface can be reached around
# Caddy -- past the cloudflare_only guard that makes CF-Connecting-IP
# trustworthy. Only set this to 0.0.0.0 on a platform that routes to the
# container by address instead of through a local proxy.
BIND_HOST=127.0.0.1

# Set to `production` so session cookies carry the Secure flag.
NODE_ENV=production

# Where news.json is written. Mirrors the store's /opt/enclave/data.
DATA_DIR=/opt/enclave-home/data

# Public origin, used to build the Discord OAuth redirect URI. The
# Discord app must list <PUBLIC_BASE_URL>/auth/discord/callback exactly.
PUBLIC_BASE_URL=https://enclaverp.cc

# Behind Caddy/Cloudflare. A forwarded header is honoured only from a
# trusted peer — see lib/auth.js.
TRUST_PROXY=true

# ---------------------------------------------------------------
# Live server board
# ---------------------------------------------------------------

# The code from cfx.re/join/<code>. The address is resolved from this on
# every refresh, so the site follows the server if its IP changes.
FIVEM_JOIN_CODE=dggpkvq

# Publish the list of players currently connected. Off by default: the
# names are pseudonymous but the list is still a live "who is in the city
# right now" feed. Identifiers and IPs are stripped either way.
FIVEM_PUBLISH_PLAYER_LIST=false

# ---------------------------------------------------------------
# Discord
# ---------------------------------------------------------------

DISCORD_GUILD_ID=1535571261395312680

# Invite code only, not the full URL. Used for the join button and, when
# no bot token is set, for the member/online counts.
DISCORD_INVITE_CODE=7KuYSBX4A

# Optional for stats (the invite works without it), required for staff to
# sign into the admin console with Discord rather than the TOTP fallback.
DISCORD_BOT_TOKEN=

# Admin sign-in. The redirect URI above must be registered on this app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Who may publish. OWNER_DISCORD_ID is one account; ADMIN_DISCORD_IDS is
# comma-separated.
OWNER_DISCORD_ID=
ADMIN_DISCORD_IDS=

# Break-glass login for the owner, as a base32 TOTP secret for an
# authenticator app. If unset the server mints a random one and prints it
# at startup, so a deployment is never protected by a public credential.
ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------
# Store
# ---------------------------------------------------------------

# Where the catalogue is read from (GET <base>/api/store), and where the
# "visit the store" buttons point. Usually the same host.
STORE_API_BASE=https://store.enclaverp.cc
STORE_URL=https://store.enclaverp.cc
