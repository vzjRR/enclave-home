# systemd unit for the Enclave RP homepage.
#
# Separate from the store's unit on purpose. The two services share a box,
# a stylesheet and a Discord app, but not a process: a crash, a deploy or
# an OOM on one must not take the other down. That isolation is why
# enclaverp.cc was a static file before this service existed, and keeping
# it is the condition on having replaced that with something dynamic.
#
#   cp deploy/enclave-home.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now enclave-home

[Unit]
Description=Enclave RP homepage (enclaverp.cc)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enclave
Group=enclave
WorkingDirectory=/opt/enclave-home
EnvironmentFile=/opt/enclave-home/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# The process needs to read its own directory and write one state file.
# Nothing else on the box is its business.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/enclave-home

# Outbound only, to Cfx.re, Discord and the store.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=enclave-home

[Install]
WantedBy=multi-user.target
